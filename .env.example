# =========================================================================
# Production & Local Environment Variables Template
# Copy this file to .env (git-ignored) for local development,
# or set these variables in your Cloud Provider's Dashboard (Render/AWS/Railway).
# =========================================================================

# Active Spring Profile: 'prod' (Cloud PostgreSQL / Neon) or 'local' (In-Memory H2)
SPRING_PROFILES_ACTIVE=prod

# Cloud Database Configuration (Neon.tech PostgreSQL)
# Best Practice: Use the PgBouncer pooler endpoint (-pooler) with sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-neon-host>-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require&reWriteBatchedInserts=true
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here

# Google Gemini AI API Key (Get yours at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (auto-assigned by cloud hosts)
PORT=8080
