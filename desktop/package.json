{
  "name": "careerpulse-desktop",
  "version": "1.0.0",
  "description": "CareerPulse - Enterprise Gamified Learning & Role Advancement Desktop Client",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -p never",
    "dist:win": "electron-builder --win -p never",
    "dist:mac": "electron-builder --mac -p never",
    "dist:linux": "electron-builder --linux -p never",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "careerpulse",
    "learning",
    "gamification",
    "desktop",
    "electron"
  ],
  "author": "CareerPulse Engineering Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
